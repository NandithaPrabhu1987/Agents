# App mode
AI_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
# Required when using Groq
GROQ_API_KEY=your_groq_key_here

# Langfuse (optional, for tracing UI)
LANGFUSE_HOST=https://cloud.langfuse.com  # or your self-host URL
LANGFUSE_PUBLIC_KEY=your_public_key
LANGFUSE_SECRET_KEY=your_secret_key

# Planner/Eval safety caps (optional)
MAX_AUTO_STEPS=3
PLANNER_MAX_TOKENS=100
JUDGE_MAX_TOKENS=120
MEMORY_RELEVANCE_LIMIT=3
MEMORY_MAX_PROMPT_CHARS=400
